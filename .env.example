# ─────────────────────────────────────────────────────────────────────────────
# Recon Automation Platform — environment configuration
#
# Copy this file to `.env` and fill in the values you need. Only the HackerOne
# credentials are required to boot the dashboard; everything else has a sane
# default and is only needed once you wire up the egress pool, notifications,
# or the encrypted credential store. See SETUP.md for how to obtain each key.
# ─────────────────────────────────────────────────────────────────────────────

# ── HackerOne API (REQUIRED) ────────────────────────────────────────────────
# Personal API token from https://hackerone.com/settings/api_token/edit
# Username is your HackerOne handle; token is the generated secret (Basic auth).
H1_API_USERNAME=your_h1_username
H1_API_TOKEN=your_h1_api_token

# ── Core wiring (optional; defaults work for a single-host local run) ─────────
# Path to the SQLite store. The Docker container sets this to /app/data/bounties.db.
# Leave unset for local runs and it resolves to ./bounties.db at the repo root.
# DB_PATH=/app/data/bounties.db

# URL the Flask app uses to reach the recon agent's HTTP API.
# Docker (network_mode: host) uses http://127.0.0.1:5001; from inside a bridged
# container it would be http://host.docker.internal:5001.
# RECON_AGENT_URL=http://127.0.0.1:5001

# ── Autopilot (optional) ─────────────────────────────────────────────────────
# Base URL the autopilot daemons call back into for pipeline orchestration.
# AUTOPILOT_API_URL=http://127.0.0.1:5000
# Max pipelines the autopilot keeps running in parallel (caps to the egress pool).
# AUTOPILOT_MAX_PARALLEL=4

# ── Egress guard (optional; only with the WireGuard exit-node pool) ───────────
# When enabled, the agent refuses to scan unless traffic egresses through the
# expected exit-node IP — a hard stop against leaking scans out your home IP.
# EXIT_NODE_GUARD_ENABLED=1
# Public IPv4 of the exit node scans must appear to come from.
# EXIT_NODE_REQUIRED_IP=your.exit.node.ip
# Tailscale IP of the exit node (used to poll its traffic stats endpoint).
# EXIT_NODE_TS_IP=100.x.y.z

# ── Encrypted credential store (optional) ────────────────────────────────────
# age identity file used to encrypt/decrypt per-program credentials at rest.
# Generate with: age-keygen -o ~/.age/key.txt && chmod 600 ~/.age/key.txt
# AGE_KEY_PATH=/home/kali/.age/key.txt

# ── Telegram notifications (optional) ─────────────────────────────────────────
# Create a bot with @BotFather to get the token; get the chat ID from
# https://api.telegram.org/bot<token>/getUpdates after messaging the bot.
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Exit-node traffic server (optional; runs ON the Hetzner exit node) ────────
# Only relevant to hetzner-exit-node/traffic-server.py, not the main app.
# TRAFFIC_BIND_IP=100.x.y.z
# TRAFFIC_PORT=9090
